# Isolated Test Environment Configuration Example
# Copy to .env.test for running isolated integration tests
NODE_ENV=test
CITYOS_ISOLATED_TEST=1
DATABASE_URL="postgresql://testuser:testpassword@127.0.0.1:5432/cityos_test"
DIRECT_URL="postgresql://testuser:testpassword@127.0.0.1:5432/cityos_test"

# NextAuth Test Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="test_super_secret_cityconnect_key_2026_test_harness"

# CityDrive Policy Configuration for Isolated Testing
CITYDRIVE_NETWORK_POLICY="CITYOS_ONLY"
CITYOS_FLEET_ORG_IDS="00000000-0000-0000-0000-000000000001"
