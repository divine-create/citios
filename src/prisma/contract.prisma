model ServiceJobQuote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceQuotes", fields: [organizationId], references: [id], onDelete: Cascade)

  customerDataId     String
  customer       CustomerData  @relation(fields: [customerDataId], references: [id], onDelete: Cascade)

