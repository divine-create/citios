  updatedAt      DateTime     @default(now())
}

model RetailRegister {
    id             String       @id @default(uuid())
    organizationId String
    locationId     String?
    location       Location?    @relation(fields: [locationId], references: [id])
  organization   Organization @relation("OrgRetailRegisters", fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       // e.g. "Register 1", "Self-Checkout A"
  isActive       Boolean      @default(true)
  
  shifts         RetailShift[]
  
  createdAt      DateTime     @default(now())
}

model RetailShift {
    id             String       @id @default(uuid())
    organizationId String
    locationId     String?
    location       Location?    @relation(fields: [locationId], references: [id])
  organization   Organization @relation("OrgRetailShifts", fields: [organizationId], references: [id], onDelete: Cascade)
  
  registerId     String
  register       RetailRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  
  openedById     String
  closedById     String?
  
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  
  openingFloat   Float        @default(0)
  expectedCash   Float?
  actualCash     Float?
  discrepancy    Float?
  
  status         String       @default("OPEN") // OPEN, CLOSED
  
  orders         RetailOrder[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

enum RetailOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RetailFulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY
  FULFILLED
  CANCELLED
  RETURNED
}

model RetailOrder {
    id             String       @id @default(uuid())
    organizationId String
    locationId     String?
    location       Location?    @relation(fields: [locationId], references: [id])
    idempotencyKey String?      @unique
  organization   Organization @relation("OrgRetailOrders", fields: [organizationId], references: [id], onDelete: Cascade)
  
  shiftId        String?
  shift          RetailShift? @relation(fields: [shiftId], references: [id])
  
  customerDataId     String?      // If attached to a loyalty program/CityConnect user
  customer       CustomerData? @relation(fields: [customerDataId], references: [id])
  cashierId      String       // The user processing it
  
  totalAmount    Float
  taxAmount      Float        @default(0)
  discountAmount Float        @default(0)

  couponId       String?
  coupon         RetailCoupon? @relation("CouponOrders", fields: [couponId], references: [id])
  
  paymentMethod  String       // CASH, CARD, SPLIT
  status         RetailOrderStatus @default(PENDING)
  fulfillmentStatus RetailFulfillmentStatus @default(UNFULFILLED)
  deliveryAddress String?
  

  refundedAt     DateTime?
  refundedById   String?
  refundReason   String?

  items          RetailOrderItem[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model RetailOrderItem {
  id             String       @id @default(uuid())
  
  orderId        String
  order          RetailOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId      String
  product        RetailProduct @relation(fields: [productId], references: [id])
  
  quantity       Float        // Float because it could be 1.5kg
  unitPrice      Float
  unitCost       Float?       // Cost of goods sold (snapshot at time of order)
  subtotal       Float
  
  discountReason String?
}

model RetailSupplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRetailSuppliers", fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  contactName    String?
  email          String?
  phone          String?
  leadTimeDays   Int?
  paymentTerms   String?      // e.g. Net-30
  
  purchaseOrders RetailPurchaseOrder[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model RetailPurchaseOrder {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRetailPurchaseOrders", fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId     String
  supplier       RetailSupplier @relation(fields: [supplierId], references: [id])

  locationId     String?
  location       Location?    @relation("LocationPurchaseOrders", fields: [locationId], references: [id])

  poNumber       String
  status         String       @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PARTIAL, RECEIVED, CANCELLED

  notes          String?
  expectedDate   DateTime?
  totalAmount    Float?

  items          RetailPurchaseOrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@index([organizationId])
}

model RetailPurchaseOrderItem {
  id          String              @id @default(uuid())
  poId        String
  po          RetailPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  productId   String
  product     RetailProduct       @relation("ProductPOItems", fields: [productId], references: [id])

  orderedQty  Float
  receivedQty Float               @default(0)
  unitCost    Float
  totalCost   Float

  createdAt   DateTime            @default(now())

  @@index([poId])
}

model RetailExpense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRetailExpenses", fields: [organizationId], references: [id], onDelete: Cascade)

  category       String   // Rent, Utilities, Supplies, Payroll, Maintenance, Marketing, Other
  description    String?
  amount         Float
  expenseDate    DateTime
  paymentMethod  String   @default("CASH") // CASH, CARD, BANK_TRANSFER, OTHER
  vendorName     String?
  receiptAssetId String?  // loose ref to Asset.id — see components/microsite's Asset model
  recordedById   String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

// Immutable per-event change to a product's stock level. Written by sales,
// refunds, manual adjustments, and (future) PO receiving so the store always
// has an auditable movement trail instead of only a current quantity.

model RetailLocationStock {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  productId      String
  product        RetailProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockQuantity  Float         @default(0) // DEPRECATED: Use RetailLocationStock
  lowStockLevel  Float?

  updatedAt      DateTime?

  @@unique([locationId, productId])
}

model RetailStockMovement {
    id             String        @id @default(uuid())
    organizationId String
    locationId     String?
    location       Location?     @relation(fields: [locationId], references: [id])
  organization   Organization  @relation("OrgRetailStockMovements", fields: [organizationId], references: [id], onDelete: Cascade)

  productId      String
  product        RetailProduct @relation("ProductStockMovements", fields: [productId], references: [id], onDelete: Cascade)

  delta          Float         // signed; +/- from the sale or correction
  beforeQty      Float
  afterQty       Float
    reason         String        // SALE | REFUND | ADJUSTMENT | RECEIVED | TRANSFER_IN | TRANSFER_OUT | DAMAGE | LOSS | PURCHASE | INITIAL_STOCK
    referenceType  String?       // ORDER | PO | REFUND
    referenceId    String?
    note           String?
  recordedById   String?       // Membership id that caused the movement

  createdAt      DateTime      @default(now())

  @@index([organizationId, productId])
  @@index([productId])
}

// Store-scoped discount code. Codes are per-organization (same code may be
// reused across different stores) with an optional expiry + usage cap.
model RetailCoupon {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRetailCoupons", fields: [organizationId], references: [id], onDelete: Cascade)

  code           String
  type           String       @default("PERCENT") // PERCENT | FIXED
  value          Float        // e.g. 10 (=10%) or 500 (=₦500 off)
  minSpend       Float        @default(0)
  isActive       Boolean      @default(true)
  usageLimit     Int?
  timesUsed      Int          @default(0)
  expiresAt      DateTime?
  description    String?
  orders         RetailOrder[] @relation("CouponOrders")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@unique([organizationId, code])
}

// In-app notifications for the store (broadcast to the store's staff).
// Generated by real events only — low stock, sales, refunds, shift close,
// PO received — never fabricated.
model RetailNotification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRetailNotifications", fields: [organizationId], references: [id], onDelete: Cascade)

  type           String       // LOW_STOCK | SALE | REFUND | SHIFT_CLOSED | PO_RECEIVED
  title          String
  message        String?
  isRead         Boolean      @default(false)

  createdAt      DateTime     @default(now())

  @@index([organizationId, isRead])
}

// A store-scoped loyalty contact — deliberately not the global User model,
// since capturing a walk-in customer's name/phone at checkout shouldn't
// require creating a full CityConnect account. totalSpent/visitCount are
// derived from RetailOrder at read time rather than stored, to avoid drift.


