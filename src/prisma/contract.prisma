  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model ServiceJobQuoteItem {
  id             String       @id @default(uuid())
  quoteId        String
  quote          ServiceJobQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description    String
  quantity       Float
  unitPrice      Float
  subtotal       Float
}

model ServiceInvoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceInvoices", fields: [organizationId], references: [id], onDelete: Cascade)

  customerDataId     String
  customer       CustomerData  @relation(fields: [customerDataId], references: [id], onDelete: Cascade)

  jobId          String?      @unique
  job            ServiceJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  status         String       @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, VOID, REFUNDED
  subtotal       Float
  discount       Float        @default(0)
  tax            Float        @default(0)
  total          Float
  amountPaid     Float        @default(0)
  dueDate        DateTime?

  items          ServiceInvoiceItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model ServiceInvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String
  invoice        ServiceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  quantity       Float
  unitPrice      Float
  subtotal       Float
}

model ServiceExpense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceExpenses", fields: [organizationId], references: [id], onDelete: Cascade)

  category       String
  amount         Float
  description    String?
  expenseDate    DateTime
  paymentMethod  String       @default("CASH")
  status         String       @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdBy      String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}


model Job {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  type           String       @default("FULL_TIME")
  pay            String?
  area           String?
  category       String?

  applications   JobApplication[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model JobApplication {
  id             String       @id @default(uuid())
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  status         String       @default("PENDING")
  coverLetter    String?

  createdAt      DateTime     @default(now())
  
  @@unique([personId, jobId])
}

model EventRegistration {
  id             String       @id @default(uuid())
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  status         String       @default("REGISTERED")

  createdAt      DateTime     @default(now())
  
  @@unique([personId, eventId])
}

model SavedItem {
  id             String       @id @default(uuid())
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  entityType     String
  entityId       String
  
  createdAt      DateTime     @default(now())
  
  @@unique([personId, entityType, entityId])
}

model Review {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  rating         Int
  body           String?
  
  createdAt      DateTime     @default(now())

  @@unique([personId, organizationId])
}



// ============================================================================
// COMMERCE & PAYMENTS (V2 Additions)
// ============================================================================


enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  MANUAL_REFUND_NEEDED
}

model Payment {
  id                String       @id @default(uuid())
  amount            Float
  currency          String       @default("USD")
  method            String       // "WALLET", "CARD", "TRANSFER"
  status            PaymentStatus @default(PENDING)
  refundedAmount    Float         @default(0.0)
  refunds           Refund[]
    
    provider          String?      // e.g. "PAYSTACK"
  reference         String?      @unique // CityOS internal payment reference
  providerReference String?      @unique // Provider's canonical transaction ID
  idempotencyKey    String?      @unique // Client's duplicate-initiation protection key
  
  transactionId     String?      @unique
  transaction       Transaction? @relation(fields: [transactionId], references: [id])
  
  restaurantOrderId String?      @unique
  restaurantOrder   RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id])
  
  retailOrderId     String?      @unique
  retailOrder       RetailOrder? @relation(fields: [retailOrderId], references: [id])
  
  events            PaymentEvent[]
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now())
}


model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  amount            Float
  currency          String       @default("USD")
  reason            String?
  status            String       @default("PENDING") // PENDING, COMPLETED, FAILED
  providerReference String?      @unique
  idempotencyKey    String?      @unique
  
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionId     String?      @unique
  transaction       Transaction? @relation(fields: [transactionId], references: [id])
  
  createdAt         DateTime     @default(now())
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  providerEventId String   @unique // Provider's unique event ID for exactly-once webhook processing
  type            String   // e.g., "charge.success", "refund.failed"
  payload         Json     // Raw or normalized event data (No PANs/CVVs)
  
  createdAt       DateTime @default(now())
  
  @@index([paymentId])
}

model DeliveryJob {
  id                String       @id @default(uuid())
  status            String       @default("PENDING") // PENDING, ASSIGNED, PICKED_UP, DELIVERED
  
  // Who is delivering?
  driverId          String?
  driver            Person?      @relation(fields: [driverId], references: [id])
  
  // Delivery coordinates / address
  dropoffAddress    String
  dropoffLat        Float?
  dropoffLng        Float?
  
  // Link to order
  restaurantOrderId String?      @unique
  restaurantOrder   RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now())
}

// ============================================================================
// RESIDENT NOTIFICATIONS
// ============================================================================

// In-app notifications for the resident. The mirror of RetailNotification
// (which is org/staff-facing): rows are created ONLY by real server-side
// events — order placed, service status changed, application submitted —
// never fabricated. Emitter: lib/notify.ts (fire-and-forget).
model Notification {
  id         String    @id @default(uuid())
  personId   String
  person     Person    @relation("PersonNotifications", fields: [personId], references: [id], onDelete: Cascade)

  type       String    // ORDER_CONFIRMED | FOOD_ORDER_CONFIRMED | SERVICE_REQUESTED | SERVICE_STATUS | JOB_APPLICATION | SYSTEM
  title      String
  body       String?
  href       String?   // deep link, e.g. /orders/<id>, /tasks
  isRead     Boolean   @default(false)
  readAt     DateTime?

  createdAt  DateTime  @default(now())

  @@index([personId, isRead, createdAt])
}


// ----------------------------------------------------------------------------
// DISCOVERY FOUNDATION (Phase 1A)
// ----------------------------------------------------------------------------

model DiscoveryListing {
  id             String       @id @default(uuid())
  organizationId String
  locationId     String?      // Optional: if listing is specific to a location
  cityId         String       // The geographic context for discovery
  
  vertical       String       // e.g. 'HOTEL', 'RESTAURANT', 'SCHOOL'
  slug           String       @unique
  title          String
  description    String?
  coverAssetId   String?
  isActive       Boolean      @default(true)
  metadata       String?      // JSON blob for vertical-specific capabilities/amenities
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  city           City         @relation("CityListings", fields: [cityId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
  
  @@unique([organizationId, vertical, locationId])
  @@index([cityId, vertical, isActive])
}


// ----------------------------------------------------------------------------
// SUBSCRIPTIONS & PLANS (Phase 1B)
// ----------------------------------------------------------------------------

model Plan {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  price          Float
  interval       String       // MONTHLY, YEARLY
  
  subscriptions  Subscription[]
  entitlements   PlanEntitlement[]
  limits         PlanLimit[]
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String
  planId         String
  status         String       // ACTIVE, CANCELLED, PAST_DUE
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean      @default(false)
  
  organization   Organization @relation("OrgSubscriptions", fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id])
}

model PlanEntitlement {
  id             String       @id @default(uuid())
  planId         String
  featureCode    String
  
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, featureCode])
}

model PlanLimit {
  id             String       @id @default(uuid())
  planId         String
  resourceCode   String
  limit          Int
  
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, resourceCode])
}



