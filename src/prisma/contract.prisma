model ServiceAppointmentAddon {
  id             String       @id @default(uuid())
  appointmentId  String
  appointment    ServiceAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  addonId        String
  addon          ServiceAddon @relation(fields: [addonId], references: [id])

  price          Float
}

model ServiceJob {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceJobs", fields: [organizationId], references: [id], onDelete: Cascade)

  customerDataId     String
  customer       CustomerData  @relation(fields: [customerDataId], references: [id], onDelete: Cascade)

  serviceId      String?
  service        ServiceCatalogItem? @relation(fields: [serviceId], references: [id])

  membershipId        String?
  staff          Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  
  quoteId        String?      @unique
  quote          ServiceJobQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  address        String?
  description    String?
  scheduledDate  DateTime?
  status         String       @default("NEW") // NEW, SCHEDULED, ASSIGNED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  priority       String       @default("NORMAL")
  notes          String?

  addons         ServiceJobAddon[]
  invoice        ServiceInvoice?
  appointment    ServiceAppointment?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model ServiceJobAddon {
  id             String       @id @default(uuid())
  jobId          String
  job            ServiceJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  addonId        String
