
model Person {
  id             String             @id @default(uuid())
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  
  account        Account?           
  identifiers    PersonIdentifier[]
  profile        ResidentProfile?
  
  memberships    Membership[]
  relationships  Relationship[]

  // Home city — the resolution-ladder fallback when no city cookie exists.
  homeCityId     String?
  homeCity       City?      @relation("PersonHomeCity", fields: [homeCityId], references: [id])

  guardianLinks  FamilyLink[]       @relation("GuardianToWard")
  wardLinks      FamilyLink[]       @relation("WardToGuardian")
  wallets        Wallet[]

  gigProfile     GigWorkerProfile?
  requestedTasks Task[]             @relation("TaskRequester")
        tickets        Ticket[]           @relation("UserTickets")
  bookings       Booking[]          @relation("UserBookings")
        postLikes      PostLike[]
  savedItems     SavedItem[]
  comments       Comment[]          @relation("UserComments")
  noticeReads    NoticeRead[]       @relation("UserNoticeReads")
  sentMessages   Message[]          @relation("SentMessages")
  receivedMessages MessageRecipient[] @relation("ReceivedMessages")
  enrolmentRequests EnrolmentRequest[] @relation("RequestedBy")
  posts          Post[]             @relation("ResidentPosts")
  follows        Follow[]           @relation("UserFollows")
  notifications  Notification[]     @relation("PersonNotifications")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now())
}

model PersonIdentifier {
  id              String   @id @default(uuid())
  personId        String
  type            String   
  normalizedValue String   
  isVerified      Boolean  @default(false)
  verifiedAt      DateTime?
  
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  claims          IdentityClaim[]
  
  @@unique([type, normalizedValue])
  @@index([normalizedValue])
}

model Account {
  id            String         @id @default(uuid())
  personId      String         @unique
  passwordHash  String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  
  person        Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  providers     AuthProvider[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
}

model AuthProvider {
  id                String   @id @default(uuid())
  accountId         String
  providerId        String   
  providerAccountId String   
  
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, providerAccountId])
}

model ResidentProfile {
  id        String  @id @default(uuid())
  personId  String  @unique
  avatarUrl String?
  timezone  String  @default("UTC")

  // Onboarding
  onboardingComplete Boolean @default(false)
  phone              String?
  interests          String? // JSON array of interest tags e.g. ["Foodie","Gaming"]
  
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model IdentityClaim {
  id                 String           @id @default(uuid())
  personIdentifierId String
  claimedByAccountId String
  status             String           
  claimedAt          DateTime         @default(now())
  resolvedAt         DateTime?
  
  identifier         PersonIdentifier @relation(fields: [personIdentifierId], references: [id], onDelete: Cascade)
}

model Membership {
  createdNotices Notice[] @relation("UserNotices")
  createdEvents SchoolEvent[] @relation("CreatedSchoolEvents")
  studentNotes StudentNote[] @relation("UserStudentNotes")
  reviewedRequests EnrolmentRequest[] @relation("ReviewedBy")
  id             String       @id @default(uuid())
  organizationId String
  locationId     String?
  personId       String
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  roles          MembershipRole[]
  locationAccess MembershipLocation[]
  staffData      StaffData?

  classes                 ClassTeacher[]
  timetableSlots          TimetableSlot[]
  timetableRequirements   TimetableRequirement[]
  leaveRequests           LeaveRequest[]
  attendance              StaffAttendance[]
  subjects                TeacherSubject[]      
  formClasses             ClassSection[]        @relation("ClassSectionFormTeacher")
  doctorAppointments      Appointment[]         @relation("DoctorAppointments")
  serviceAppointments     ServiceAppointment[]
  serviceJobs             ServiceJob[]
  
  createdAt      DateTime     @default(now())
  
  @@unique([organizationId, personId])
  @@index([personId])
}

model MembershipRole {
  id           String     @id @default(uuid())
  membershipId String
  role         String     
  
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  
  @@unique([membershipId, role])
}

model MembershipLocation {
  id           String     @id @default(uuid())
  membershipId String
  locationId   String
  
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  @@unique([membershipId, locationId])
}

model Relationship {
  guestReservations Reservation[] @relation("GuestReservations")
  id             String       @id @default(uuid())
  organizationId String
  personId       String
  type           String       
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  studentData    StudentData?
  customerData   CustomerData?
  patientData    PatientData?
  guardianAuths  GuardianAuthorization[]
  
  createdAt      DateTime     @default(now())
  
  @@unique([organizationId, personId, type])
  @@index([personId])
}

model StudentData {
  id             String       @id @default(uuid())
  relationshipId String       @unique
  admissionNo    String?
  yearLevel      Int?
  
  classSectionId String?
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  
  classEnrolments     ClassEnrolment[]
  attendance          Attendance[]
  grades              Grade[]
  feeInvoices         FeeInvoice[]
  documents           Document[]
  exitRecord          StudentExit?
  transferIn          StudentTransferIn?
  behaviourIncidents  BehaviourIncident[]
  suspensions         Suspension[]
  truancyAlerts       TruancyAlert[]
  notes               StudentNote[]
  waitlistEntries     WaitlistEntry[]
  enrolmentRequests   EnrolmentRequest[]
}

model CustomerData {
  restaurantOrders RestaurantOrder[] @relation("CustomerRestaurantOrders")
  id             String       @id @default(uuid())
  relationshipId String       @unique
  loyaltyPoints  Int          @default(0)
  notes          String?
  
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  retailOrders   RetailOrder[]
  appointments   ServiceAppointment[]
  jobs           ServiceJob[]
  quotes         ServiceJobQuote[]
  invoices       ServiceInvoice[]
}

model PatientData {
  appointments Appointment[] @relation("PatientAppointments")
  prescriptions Prescription[] @relation("PatientPrescriptions")
  pharmacyOrders PharmacyOrder[] @relation("PatientPharmacyOrders")
  id             String       @id @default(uuid())
  relationshipId String       @unique
  medicalNotes   String?
  
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
}

model StaffData {
  id             String       @id @default(uuid())
  membershipId   String       @unique
  employeeId     String?
  bio            String?
  
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String?
  phone          String?
  role           String
  token          String       @unique
  expiresAt      DateTime
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FamilyLink {
  id               String   @id @default(uuid())
  guardianPersonId String
  wardPersonId     String
  type             String   
  
  guardian         Person   @relation("GuardianToWard", fields: [guardianPersonId], references: [id], onDelete: Cascade)
  ward             Person   @relation("WardToGuardian", fields: [wardPersonId], references: [id], onDelete: Cascade)
  
  @@unique([guardianPersonId, wardPersonId])
}

model GuardianAuthorization {
  id                 String       @id @default(uuid())
  organizationId     String
  guardianPersonId   String
  wardRelationshipId String
  permissions        String       
  
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wardRelationship   Relationship @relation(fields: [wardRelationshipId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, guardianPersonId, wardRelationshipId])
}

model Location {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberAccess   MembershipLocation[]

  cityId         String?
  city           City?        @relation("CityLocations", fields: [cityId], references: [id])
  listings       DiscoveryListing[]
  bookings       Booking[]          @relation("LocationBookings")
  
  // RestaurantOS Location Relations
  restaurantMenuItems MenuItem[]      @relation("LocationMenuItems")
  restaurantOrders    RestaurantOrder[] @relation("LocationRestaurantOrders")
  restaurantTables    RestaurantTable[] @relation("LocationRestaurantTables")
  restaurantReservations RestaurantReservation[] @relation("LocationRestaurantReservations")
  restaurantInventory RestaurantInventoryItem[] @relation("LocationRestaurantInventory")
    restaurantProductionRuns RestaurantProductionRun[] @relation("LocationRestaurantProductionRuns")
  restaurantExpenses  RestaurantExpense[] @relation("LocationRestaurantExpenses")
}

model Wallet {
  id             String       @id @default(uuid())
  balance        Float        @default(0.0)
  currency       String       @default("USD")
  
  personId       String?      
  organizationId String?      
  
  person         Person?      @relation(fields: [personId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  
  entries        LedgerEntry[]
  
  @@unique([personId])
  @@unique([organizationId])
}

model Transaction {
  id             String       @id @default(uuid())
  status         String       
  reference      String?
  description    String?
  
  entries        LedgerEntry[]
  
  payment        Payment?
  createdAt      DateTime     @default(now())
}

model LedgerEntry {
  id             String       @id @default(uuid())
  walletId       String
  transactionId  String
  amount         Float        
  currency       String
  
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  
  createdAt      DateTime     @default(now())
  
  @@index([walletId])
  @@index([transactionId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


// ----------------------------------------------------------------------------
// UNIVERSAL IDENTITY (NextAuth Standard Models + CityConnect Additions)
// ----------------------------------------------------------------------------







// ----------------------------------------------------------------------------
// CITY REGISTRY (CityContext)
// ----------------------------------------------------------------------------
// Every supported city, its locale, and the organizations operating there.
// Kept intentionally minimal for now: no geographic boundaries/rules yet,
// just enough to scope organizations by city and let CityContext pick one.

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String
  // State/region the city belongs to (e.g. a Nigerian LGA's state). Lets the
  // city picker group and disambiguate entries that share a name.
  state     String?
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Geographic center — used by geolocation to suggest the nearest city.
  latitude  Float?
  longitude Float?

  residents     Person[]       @relation("PersonHomeCity")
  locations     Location[]     @relation("CityLocations")
  listings      DiscoveryListing[]     @relation("CityListings")
}

// ----------------------------------------------------------------------------
// ORGANIZATIONS & RBAC (The SaaS Admin Portals)
// ----------------------------------------------------------------------------

enum OrgType {
  GOVERNMENT
  SCHOOL
  HEALTHCARE
  RETAIL
  RESTAURANT
  REAL_ESTATE
  SERVICES
  LOGISTICS
  HOTEL
  EVENT_ORGANIZER
  PUBLISHER
  PHARMACY
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  type        OrgType
  storeCategory String?
  description String?
  address     String?
  logoAssetId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())


  posts       Post[]
  followers   Follow[]             @relation("OrgFollowers")
  tasks       Task[]               @relation("OrganizationTasks")
  hotelRooms  HotelRoom[]          @relation("HotelRooms")
  reservations Reservation[]       @relation("HotelReservations")
  rateRules   RateRule[]           @relation("HotelRateRules")
  inventoryItems InventoryItem[]   @relation("OrganizationInventory")
  roomBlocks  RoomBlock[]          @relation("HotelRoomBlocks")
  outlets     Outlet[]             @relation("HotelOutlets")
  outletOrders OutletOrder[]       @relation("HotelOutletOrders")
  maintenanceTickets MaintenanceTicket[] @relation("HotelMaintenanceTickets")
  nightAudits NightAuditReport[]   @relation("HotelNightAudits")
  menuItems   MenuItem[]           @relation("RestaurantMenuItems")
  restaurantOrders RestaurantOrder[] @relation("RestaurantOrders")
  events      Event[]              @relation("OrganizationEvents")
  rentalResources RentalResource[] @relation("OrganizationRentalResources")
  appointments Appointment[]       @relation("ClinicAppointments")
  prescriptions Prescription[]     @relation("ClinicPrescriptions")
  pharmacyItems PharmacyItem[]     @relation("PharmacyItems")
  pharmacyOrders PharmacyOrder[]   @relation("PharmacyOrders")
  microsite   Microsite?           @relation("OrgMicrosite")
  assets      Asset[]              @relation("OrgAssets")

  // ShopOS (Retail/Grocery)
  retailProducts      RetailProduct[]      @relation("OrgRetailProducts")
  retailCategories    RetailCategory[]     @relation("OrgRetailCategories")
  retailOrders        RetailOrder[]        @relation("OrgRetailOrders")
  retailSuppliers     RetailSupplier[]     @relation("OrgRetailSuppliers")
  retailPurchaseOrders RetailPurchaseOrder[] @relation("OrgRetailPurchaseOrders")
  retailRegisters     RetailRegister[]     @relation("OrgRetailRegisters")
  retailShifts        RetailShift[]        @relation("OrgRetailShifts")
  retailExpenses      RetailExpense[]      @relation("OrgRetailExpenses")
  retailSettings      RetailSettings?      @relation("OrgRetailSettings")
  retailCoupons       RetailCoupon[]       @relation("OrgRetailCoupons")
  retailStockMovements RetailStockMovement[] @relation("OrgRetailStockMovements")
  retailNotifications RetailNotification[] @relation("OrgRetailNotifications")

  // CityOS Universal CRM
  // ServiceOS
  serviceSettings     ServiceSettings?     @relation("OrgServiceSettings")
  serviceCategories   ServiceCategory[]    @relation("OrgServiceCategories")
  serviceCatalogItems ServiceCatalogItem[] @relation("OrgServiceCatalogItems")
  serviceAddons       ServiceAddon[]       @relation("OrgServiceAddons")
  serviceAppointments ServiceAppointment[] @relation("OrgServiceAppointments")
  serviceJobs         ServiceJob[]         @relation("OrgServiceJobs")
  serviceQuotes       ServiceJobQuote[]       @relation("OrgServiceQuotes")
  serviceInvoices     ServiceInvoice[]     @relation("OrgServiceInvoices")
  serviceExpenses     ServiceExpense[]     @relation("OrgServiceExpenses")

  // RestaurantOS (Restaurants, Eateries & Fast Food)
  restaurantSettings     RestaurantSettings?       @relation("OrgRestaurantSettings")
  restaurantTables       RestaurantTable[]         @relation("RestaurantTables")
  restaurantReservations RestaurantReservation[]    @relation("OrgRestaurantReservations")
  restaurantInventory    RestaurantInventoryItem[] @relation("RestaurantInventory")
  restaurantStockMovements RestaurantStockMovement[] @relation("RestaurantStockMovements")
    restaurantRecipes      RestaurantRecipe[]        @relation("RestaurantRecipes")
    restaurantProductionRuns RestaurantProductionRun[] @relation("OrgRestaurantProductionRuns")
  restaurantExpenses     RestaurantExpense[]       @relation("OrgRestaurantExpenses")
  menuItemAddons         MenuItemAddon[]           @relation("OrgMenuItemAddons")
  menuItemVariants       MenuItemVariant[]         @relation("OrgMenuItemVariants")
  menuItemCombos         MenuItemCombo[]           @relation("OrgMenuItemCombos")
  listings    DiscoveryListing[]
  subscriptions Subscription[] @relation("OrgSubscriptions")
  bookings      Booking[]      @relation("OrgBookings")
}

enum OrgRole {
  OWNER
  MANAGER
  STAFF
  // specific roles
  TEACHER
  DOCTOR
  ADMIN
  FINANCE
  REGISTRAR
  COUNSELOR
  LIBRARIAN
  HOTEL_MANAGER
  HOTEL_FRONT_DESK
  HOTEL_HOUSEKEEPER
  CASHIER
  INVENTORY_STAFF
  // RestaurantOS
  WAITER
    KITCHEN
    CHEF
    HOST
    STOREKEEPER
    DELIVERY_DRIVER
  }

// ----------------------------------------------------------------------------
// SHOPOS: RETAIL & GROCERY MANAGEMENT
// ----------------------------------------------------------------------------

model RetailSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation("OrgRetailSettings", fields: [organizationId], references: [id], onDelete: Cascade)

  storeName      String?
  storeAddress   String?
  receiptMessage String?
  taxEnabled     Boolean      @default(false)
  taxRate        Float        @default(0)
  currencySymbol String       @default("$")

  // Onboarding Data
  storeUrl       String?
  country        String?
  weeklyOrders   String?
  currencies     String?      // JSON array of strings
  staffCount     String?
  physicalStores String?
  
  // Onboarding Progress Flags
  hasSetPayment      Boolean @default(false)
  hasStoreInfo       Boolean @default(false)
  hasShippingPrices  Boolean @default(false)
  hasProducts        Boolean @default(false)
  walletSettlementEnabled Boolean @default(false)

  // Payment Configuration
  paymentGateway     String?
  bankDetails        String?      // JSON string: { bankName, accountNumber, accountName }
  
  // Shipping Configuration
  shippingRates      String?      // JSON string array: [{ id, name, price, condition }]

  customUnits    String?      // JSON string array e.g. '["ea", "lb", "kg", "pack", "box"]'

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}



// ----------------------------------------------------------------------------
// MICROSITE BUILDER (cross-vertical: one dedicated public website per
// Organization, independent of any per-vertical admin portal or of how the
// org already shows up in-app listings like Explore)
// ----------------------------------------------------------------------------

model Microsite {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  organization         Organization @relation("OrgMicrosite", fields: [organizationId], references: [id], onDelete: Cascade)

  slug                 String       @unique // subdomain/path segment: <slug>.cityconnect.app
  title                String
  tagline              String?
  theme                String       @default("minimal")
  status               String       @default("draft") // draft | published
  seoTitle             String?
  seoDescription       String?
  logoAssetId          String?
  faviconAssetId       String?
  publishedAt          DateTime?

  // Brand Kit
  primaryColor         String       @default("#2563EB")
  secondaryColor       String       @default("#1E40AF")
  accentColor          String       @default("#F59E0B")
  headingFont          String       @default("inter")
  bodyFont             String       @default("inter")
  buttonStyle          String       @default("rounded") // pill | rounded | square
  borderRadius         String       @default("md")      // none | sm | md | lg | full

  // Domain Management
  customDomain         String?      @unique
  domainSubscriptionId String?      // Stripe subscription ID for the domain billing
  domainAutoRenew      Boolean      @default(true)
  domainExpiresAt      DateTime?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now())

  pages                MicrositePage[]
  sections             MicrositeSection[]
  navItems             MicrositeNavigationItem[] @relation("MicrositeNavItems")
  inquiries            MicrositeInquiry[] @relation("MicrositeInquiries")
}

model MicrositePage {
  id             String       @id @default(uuid())
  micrositeId    String
  microsite      Microsite    @relation(fields: [micrositeId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  status         String       @default("published") // draft | published
  isHome         Boolean      @default(false)
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  sortOrder      Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  sections       MicrositeSection[] @relation("PageSections")
  navItems       MicrositeNavigationItem[] @relation("PageNavItems")
}

model MicrositeNavigationItem {
  id            String    @id @default(uuid())
  micrositeId   String
  microsite     Microsite @relation("MicrositeNavItems", fields: [micrositeId], references: [id], onDelete: Cascade)
  label         String
  url           String?
  pageId        String?
  page          MicrositePage? @relation("PageNavItems", fields: [pageId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        MicrositeNavigationItem? @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      MicrositeNavigationItem[] @relation("NavHierarchy")
  order         Int       @default(0)
  isHidden      Boolean   @default(false)
}

model MicrositeSection {
  id          String    @id @default(uuid())
  micrositeId String
  microsite   Microsite @relation(fields: [micrositeId], references: [id], onDelete: Cascade)
  
  pageId      String?
  page        MicrositePage? @relation("PageSections", fields: [pageId], references: [id], onDelete: Cascade)

  type        String  // hero | about | services | gallery | hours | testimonials | contact | cta | footer
  order       Int     @default(0)
  visible     Boolean @default(true)
  content     String  // JSON-encoded payload; shape depends on `type`

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

// Self-hosted binary storage (base64 in `data`) for microsite images — no
// external object-store dependency. Fine for a prototype's image volume;
// swapping the storage backend later only touches this model + the asset
// route, never the callers, since they only ever hold an Asset id.
model Asset {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgAssets", fields: [organizationId], references: [id], onDelete: Cascade)

  fileName  String
  mimeType  String
  size      Int
  data      String // base64-encoded file content

  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// CITYPAY (Financial Engine)
// ----------------------------------------------------------------------------

enum WalletType {
  RESIDENT
  ORGANIZATION
}





// ----------------------------------------------------------------------------
// CITYDRIVE (Logistics Engine)
// ----------------------------------------------------------------------------

model GigWorkerProfile {
  acceptedTasks Task[] @relation("TaskCourier")
  id             String   @id @default(uuid())
  personId         String   @unique
  vehicleType    String?  // CAR, BIKE, SCOOTER
  licensePlate   String?
  isOnline       Boolean  @default(false)
  rating         Float    @default(5.0)
  createdAt      DateTime @default(now())

  person           Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
}

enum TaskType {
  PASSENGER_RIDE
  FOOD_DELIVERY
  PACKAGE_DELIVERY
  SERVICE_DISPATCH
}

enum TaskStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Task {
  id               String       @id @default(uuid())
  type             TaskType
  status           TaskStatus   @default(PENDING)
  pickupAddress    String
  dropoffAddress   String
  price            Float
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now())

  requesterPersonId      String       // The Resident who ordered the ride/food
  courierProfileId        String?      // The Courier who accepted it
  organizationId   String?      // The Restaurant that prepared the food (optional)

  requester        Person          @relation("TaskRequester", fields: [requesterPersonId], references: [id])
  courier          GigWorkerProfile?         @relation("TaskCourier", fields: [courierProfileId], references: [id])
  organization     Organization? @relation("OrganizationTasks", fields: [organizationId], references: [id])
  quote            ServiceQuote?
}

// ----------------------------------------------------------------------------
// COMMUNITY FEED
// ----------------------------------------------------------------------------

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model Post {
  id             String       @id @default(uuid())
  title          String
  content        String
  category       String
  isEmergency    Boolean      @default(false)
  status         PostStatus   @default(PUBLISHED)
  viewCount      Int          @default(0)
  shareCount     Int          @default(0)
  createdAt      DateTime     @default(now())
    
    imageUrl       String?
    videoUrl       String?
    eventDate      DateTime?
    location       String?
    price          Float?
    postMetadata   String?
    
    organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String?
  person         Person?       @relation("ResidentPosts", fields: [personId], references: [id], onDelete: Cascade)
  
  linkedEntityType String?
  linkedEntityId   String?

  comments       Comment[]
  likes          PostLike[]

  @@unique([linkedEntityType, linkedEntityId])
}

model Follow {
  id             String       @id @default(uuid())
  personId       String
  person         Person       @relation("UserFollows", fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("OrgFollowers", fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([personId, organizationId])
}

model PostLike {
  id             String       @id @default(uuid())
  postId         String
  personId         String
  
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  person           Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())

  @@unique([postId, personId])
}

model Comment {
  id             String       @id @default(uuid())
  content        String
  
  postId         String
  personId         String
  
  post           Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  person           Person         @relation("UserComments", fields: [personId], references: [id], onDelete: Cascade)
  
  parentId       String?
  parent         Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Comment[]      @relation("CommentReplies")
  
  createdAt      DateTime     @default(now())
}

// ----------------------------------------------------------------------------
// HOSPITALITY / HOTEL PMS
// ----------------------------------------------------------------------------

model HotelRoom {
  id             String       @id @default(uuid())
  roomNumber     String
  type           String       // King, Double, Suite
  status         String       @default("CLEAN") // CLEAN, DIRTY, INSPECTING, OUT_OF_ORDER
  baseRate       Float        @default(0)
  organizationId String
  locationId     String?
  organization   Organization @relation("HotelRooms", fields: [organizationId], references: [id], onDelete: Cascade)

  reservations   Reservation[]
  maintenanceTickets MaintenanceTicket[]
  housekeepingLogs HousekeepingLog[]
}

model HousekeepingLog {
  id              String   @id @default(uuid())
  roomId          String
  housekeeperId   String?  // Optional relation to User if needed, or string
  statusChangedTo String
  timestamp       DateTime @default(now())

  room            HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Reservation {
  id             String       @id @default(uuid())
  guestName      String
  guestRelationshipId        String?      // Optional link to a Resident User
  roomId         String?
  status         ReservationStatus @default(CONFIRMED)
  checkInDate    DateTime
  checkOutDate   DateTime
  totalPrice     Float?       // Nights * room rate at time of booking
  paymentStatus  String       @default("PENDING") // PENDING, DEPOSIT_PAID, PAID
  roomBlockId    String?      // Set when this reservation was made as part of a group block

  organizationId String
  locationId     String?

  guestRelationship          Relationship?        @relation("GuestReservations", fields: [guestRelationshipId], references: [id])
  room           HotelRoom?   @relation(fields: [roomId], references: [id])
  roomBlock      RoomBlock?   @relation(fields: [roomBlockId], references: [id], onDelete: SetNull)
  organization   Organization @relation("HotelReservations", fields: [organizationId], references: [id], onDelete: Cascade)

  folioCharges   FolioCharge[]
  outletOrders   OutletOrder[]

  createdAt      DateTime     @default(now())
}

model RoomBlock {
  id             String       @id @default(uuid())
  organizationId String
  locationId     String?
  groupName      String
  checkInDate    DateTime
  checkOutDate   DateTime
  notes          String?

  organization   Organization @relation("HotelRoomBlocks", fields: [organizationId], references: [id], onDelete: Cascade)
  reservations   Reservation[]

  createdAt      DateTime     @default(now())
}

enum FolioChargeCategory {
  ROOM
  FOOD_AND_BEVERAGE
  SPA
  OTHER
}

model FolioCharge {
  id             String              @id @default(uuid())
  reservationId  String
  description    String
  amount         Float
  category       FolioChargeCategory @default(OTHER)

  reservation    Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt      DateTime            @default(now())
}

enum OutletType {
  RESTAURANT
  BAR
  CLUB
  SPA
}

model Outlet {
  id             String       @id @default(uuid())
  organizationId String
  locationId     String?
  name           String
  type           OutletType
  isActive       Boolean      @default(true) // whether this outlet's POS is available for staff to use

  organization   Organization @relation("HotelOutlets", fields: [organizationId], references: [id], onDelete: Cascade)
  items          OutletItem[]
  orders         OutletOrder[]

  createdAt      DateTime     @default(now())
}

model OutletItem {
  id         String   @id @default(uuid())
  outletId   String
  name       String
  price      Float
  category   String

  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderItems OutletOrderItem[]

  createdAt  DateTime @default(now())
}

enum OutletOrderStatus {
  OPEN
  PAID
  CHARGED_TO_ROOM
}

model OutletOrder {
  id            String            @id @default(uuid())
  outletId      String
  organizationId String
  tabName       String            // table number, tab name, or guest name for walk-ins
  status        OutletOrderStatus @default(OPEN)
  totalAmount   Float             @default(0)
  reservationId String?           // set once charged to a guest's room

  outlet        Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  organization  Organization      @relation("HotelOutletOrders", fields: [organizationId], references: [id], onDelete: Cascade)
  reservation   Reservation?      @relation(fields: [reservationId], references: [id])
  items         OutletOrderItem[]

  createdAt     DateTime          @default(now())
}

model OutletOrderItem {
  id            String      @id @default(uuid())
  outletOrderId String
  outletItemId  String
  quantity      Int         @default(1)
  unitPrice     Float

  outletOrder   OutletOrder @relation(fields: [outletOrderId], references: [id], onDelete: Cascade)
  outletItem    OutletItem  @relation(fields: [outletItemId], references: [id])
}

enum MaintenanceTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenanceTicketPriority {
  LOW
  MEDIUM
  HIGH
}

model MaintenanceTicket {
  id             String                    @id @default(uuid())
  organizationId String
  locationId     String?
  roomId         String?
  title          String
  description    String?
  status         MaintenanceTicketStatus   @default(OPEN)
  priority       MaintenanceTicketPriority @default(MEDIUM)

  organization   Organization              @relation("HotelMaintenanceTickets", fields: [organizationId], references: [id], onDelete: Cascade)
  room           HotelRoom?                @relation(fields: [roomId], references: [id])

  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?
}

model NightAuditReport {
  id             String       @id @default(uuid())
  organizationId String
  auditDate      DateTime
  roomRevenue    Float
  fnbRevenue     Float
  otherRevenue   Float
  totalRevenue   Float
  occupancyRate  Float
  roomsSold      Int

  organization   Organization @relation("HotelNightAudits", fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@unique([organizationId, auditDate])
}

enum RateRuleType {
  WEEKEND_SURGE
  HOLIDAY_SURGE
}

model RateRule {
  id             String       @id @default(uuid())
  organizationId String
  type           RateRuleType
  multiplier     Float        // e.g. 1.20 = +20%
  isActive       Boolean      @default(true)

  organization   Organization @relation("HotelRateRules", fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@unique([organizationId, type])
}

enum InventoryCategory {
  HOUSEKEEPING
  FOOD_AND_BEVERAGE
  MAINTENANCE
}

model InventoryItem {
  id             String            @id @default(uuid())
  organizationId String
  locationId     String?
  name           String
  category       InventoryCategory
  unit           String            // e.g. "units", "bottles", "rolls"
  quantityOnHand Int               @default(0)
  parLevel       Int               @default(0) // reorder threshold

  organization   Organization      @relation("OrganizationInventory", fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now())
}


// ----------------------------------------------------------------------------
// EDUCATION / SCHOOL MANAGEMENT (TPT Integration)
// ----------------------------------------------------------------------------

model SchoolSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation("SchoolSettings", fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  shortName      String?
  address        String?  // Used as street address
  state          String?  // Nigerian State
  lga            String?  // Local Government Area
  phone          String?
  email          String?
  website        String?
  logo           String?
  timezone       String   @default("UTC")
  currencyCode   String   @default("USD")
  currencySymbol String   @default("$")
  schoolType     String   @default("both")
  currentYear    Int
  currentTerm    Int      @default(1)
  setupComplete  Boolean  @default(false)
  
  emailProvider  String   @default("smtp") // smtp | resend | mailjet | sendgrid
  aiProvider     String   @default("none") // none | anthropic | openrouter | local
  aiReportMode   String   @default("assist") // assist | auto
  
  parentMessagingDefault Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model AcademicYear {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolAcademicYears", fields: [organizationId], references: [id], onDelete: Cascade)
  
  year      Int
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)

  terms   Term[]
  classes SchoolClass[]

  @@unique([organizationId, year])
}

model Term {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolTerms", fields: [organizationId], references: [id], onDelete: Cascade)

  academicYearId String
  termNumber     Int
  name           String
  startDate      DateTime
  endDate        DateTime
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  attendances    Attendance[]
  gradebooks     Gradebook[]

  @@unique([academicYearId, termNumber])
}



model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolLeaveRequests", fields: [organizationId], references: [id], onDelete: Cascade)

  membershipId    String
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("pending")
  approvedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  staff      Membership    @relation(fields: [membershipId], references: [id])
}

model StaffAttendance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolStaffAttendances", fields: [organizationId], references: [id], onDelete: Cascade)

  membershipId String
  date    DateTime
  status  String
  notes   String?
  staff   Membership    @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, date])
}





// ----------------------------------------------------------------------------


model Document {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolDocuments", fields: [organizationId], references: [id], onDelete: Cascade)

  studentDataId  String
  name       String
  type       String
  filePath   String
  uploadedAt DateTime @default(now())
  student    StudentData  @relation(fields: [studentDataId], references: [id], onDelete: Cascade)
}

model StudentNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolStudentNotes", fields: [organizationId], references: [id], onDelete: Cascade)

  studentDataId String
  authorMembershipId  String
  content   String
  type      String   @default("general") // general | academic | medical | behaviour | pastoral
  private   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  student   StudentData  @relation(fields: [studentDataId], references: [id], onDelete: Cascade)
  author    Membership     @relation("UserStudentNotes", fields: [authorMembershipId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolWaitlistEntries", fields: [organizationId], references: [id], onDelete: Cascade)

  classId   String
  studentDataId String
  position  Int
  addedAt   DateTime @default(now())
  notes     String?
  class     SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   StudentData  @relation(fields: [studentDataId], references: [id], onDelete: Cascade)

  @@unique([classId, studentDataId])
}

model EnrolmentRequest {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation("SchoolEnrolmentRequests", fields: [organizationId], references: [id], onDelete: Cascade)

  classId          String
  studentDataId        String
  requestedByPersonId    String
  message          String?
  status           String    @default("pending") // pending | approved | rejected
  reviewedByMembershipId     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  class            SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student          StudentData   @relation(fields: [studentDataId], references: [id], onDelete: Cascade)
  requestedBy      Person      @relation("RequestedBy", fields: [requestedByPersonId], references: [id])
  reviewedBy       Membership?     @relation("ReviewedBy", fields: [reviewedByMembershipId], references: [id])

  @@unique([classId, studentDataId])
}

model SchoolClass {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation("SchoolClasses", fields: [organizationId], references: [id], onDelete: Cascade)

  academicYearId String
  name           String
  code           String
  subject        String? // free-text legacy field; prefer subjectId going forward
  subjectId      String?
  classSectionId String? // which class section this subject offering belongs to
  yearLevel      Int?
  roomId         String?
  maxStudents    Int?
  description    String?
  periodsPerWeek Int            @default(5)

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  subjectRef        Subject?           @relation(fields: [subjectId], references: [id])
  classSection      ClassSection?      @relation(fields: [classSectionId], references: [id])
  teachers          ClassTeacher[]
  enrolments        ClassEnrolment[]
  timetableSlots    TimetableSlot[]
  gradebooks        Gradebook[]
  waitlistEntries   WaitlistEntry[]
  enrolmentRequests EnrolmentRequest[]
  timetableRequirements TimetableRequirement[]

  @@unique([academicYearId, code])
}

model ClassTeacher {
  id        String       @id @default(uuid())
  classId   String
  membershipId   String
  isPrimary Boolean @default(false)
  class     SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  staff     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([classId, membershipId])
}

model ClassEnrolment {
  id         String   @id @default(uuid())
  classId    String
  studentDataId  String
  enrolledAt DateTime @default(now())
  status     String   @default("active")
  class      SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    StudentData  @relation(fields: [studentDataId], references: [id], onDelete: Cascade)

  @@unique([classId, studentDataId])
}

// A "class arm" is a year-level section/stream (e.g. "Grade 10 - A") that a
// student is placed into for homeroom/form purposes — distinct from
// SchoolClass, which is a single subject taught by one teacher.
model SchoolGrade {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolGrades", fields: [organizationId], references: [id], onDelete: Cascade)

  name           String // "JSS1", "Grade 10", "Class 6"...
  level          Int    // numeric order, also matched against Student.yearLevel / SchoolClass.yearLevel

  sections       ClassSection[]

  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model ClassSection {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolClassSections", fields: [organizationId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  gradeId        String
  grade          SchoolGrade  @relation(fields: [gradeId], references: [id])

  name           String // "A", "B", "Gold"...
  formMembershipId  String?
  formTeacher    Membership? @relation("ClassSectionFormTeacher", fields: [formMembershipId], references: [id])

  students       StudentData[]
  classes        SchoolClass[]

  createdAt      DateTime     @default(now())

  @@unique([academicYearId, gradeId, name])
}

// A subject an org teaches (Mathematics, English...) — admin-managed, freely
// created. SchoolClass rows are the "offering" of a subject to a class arm
// with an assigned teacher; TeacherSubject records which subjects a teacher
// is assigned/qualified to teach in general (independent of any one class).
model Subject {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolSubjects", fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  code           String?

  classes        SchoolClass[]
  teacherLinks   TeacherSubject[]

  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model TeacherSubject {
  id        String       @id @default(uuid())
  membershipId   String
  staff     Membership @relation("StaffSubjects", fields: [membershipId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())

  @@unique([membershipId, subjectId])
}

enum SyllabusTopicStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model SyllabusTopic {
  id          String              @id @default(uuid())
  classId     String
  class       SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId      String
  term        Term                @relation(fields: [termId], references: [id])

  title       String
  description String?
  week        Int?
  order       Int                 @default(0)
  status      SyllabusTopicStatus @default(PLANNED)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now())
}

model Room {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolRooms", fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  code     String
  capacity Int?
  type     String?
  building String?
  floor    String?

  classes                  SchoolClass[]
  timetableSlots           TimetableSlot[]
  timetableRequirements    TimetableRequirement[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model TimetableSlot {
  id        String  @id @default(uuid())
  classId   String
  membershipId   String?
  roomId    String?
  dayOfWeek Int
  period    Int
  startTime String
  endTime   String
  notes     String?
  class     SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  staff     Membership?  @relation(fields: [membershipId], references: [id])
  room      Room?   @relation(fields: [roomId], references: [id])
}

model TimetableRequirement {
  id              String  @id @default(uuid())
  classId         String
  membershipId         String?
  preferredRoomId String?
  periodsPerWeek  Int
  label           String?  // e.g. "Math with Mr Smith"
  class           SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  staff           Membership?  @relation(fields: [membershipId], references: [id])
  preferredRoom   Room?   @relation(fields: [preferredRoomId], references: [id])

  @@unique([classId, membershipId])
}

model Attendance {
  id         String   @id @default(uuid())
  organizationId String?
  studentDataId  String
  termId     String
  date       DateTime
  status     String
  notes      String?
  markedById String?
  markedAt   DateTime @default(now())
  student    StudentData  @relation(fields: [studentDataId], references: [id], onDelete: Cascade)
  term       Term     @relation(fields: [termId], references: [id])

  @@unique([studentDataId, date])
}

model Gradebook {
  id          String    @id @default(uuid())
  organizationId String?
  classId     String
  termId      String
  name        String
  description String?
  maxScore    Float     @default(100)
  weight      Float     @default(1)
  dueDate     DateTime?
  type        String    @default("assessment")
  documentUrl String?
  class       SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  term        Term      @relation(fields: [termId], references: [id])
  grades      Grade[]
}

model Grade {
  id          String    @id @default(uuid())
  organizationId String?
  gradebookId String
  studentDataId   String
  score       Float?
  grade       String?
  comment     String?
  submittedAt   DateTime?
  submissionUrl String?
  gradedAt      DateTime?
  gradedById    String?
  gradebook   Gradebook @relation(fields: [gradebookId], references: [id], onDelete: Cascade)
  student     StudentData   @relation(fields: [studentDataId], references: [id], onDelete: Cascade)

  @@unique([gradebookId, studentDataId])
}

model ReportCard {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolReportCards", fields: [organizationId], references: [id], onDelete: Cascade)

  studentDataId      String
  termId         String
  academicYear   Int
  comments       String?
  teacherNotes   String?
  principalNotes String?
  issuedAt       DateTime?
  published      Boolean   @default(false)
  pdfPath        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@unique([studentDataId, termId])
}

model GradingScale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolGradingScales", fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  boundaries GradeBoundary[]

  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model GradeBoundary {
  id             String       @id @default(uuid())
  gradingScaleId String
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  minPercent Float
  maxPercent Float
  label      String  // "A"
  remark     String? // "Excellent"
  order      Int     @default(0)
}

model Notice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolNotices", fields: [organizationId], references: [id], onDelete: Cascade)

  authorMembershipId    String
  title       String
  body        String
  category    String    @default("general")
  targetRoles String    @default("all")
  targetYears String?
  publishedAt DateTime?
  expiresAt   DateTime?
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  author      Membership       @relation("UserNotices", fields: [authorMembershipId], references: [id])
  reads       NoticeRead[]
}

model NoticeRead {
  id        String   @id @default(uuid())
  noticeId  String
  personId    String
  readAt    DateTime @default(now())
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  person      Person     @relation("UserNoticeReads", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([noticeId, personId])
}

model Message {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation("SchoolMessages", fields: [organizationId], references: [id], onDelete: Cascade)

  senderPersonId   String
  subject    String?
  body       String
  parentId   String?            // null = root message; set = reply
  threadId   String             // denormalized root message id (equals id for root)
  createdAt  DateTime           @default(now())
  sender     Person               @relation("SentMessages", fields: [senderPersonId], references: [id])
  recipients MessageRecipient[]
  parent     Message?           @relation("Replies", fields: [parentId], references: [id])
  replies    Message[]          @relation("Replies")

  @@index([threadId])
}

model MessageRecipient {
  id        String   @id @default(uuid())
  messageId String
  personId    String
  readAt    DateTime?
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  person      Person     @relation("ReceivedMessages", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([messageId, personId])
}

model EmailLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("SchoolEmailLogs", fields: [organizationId], references: [id], onDelete: Cascade)

  to        String
  subject   String
  body      String
  status    String    @default("pending")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

model AttendanceCode {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation("SchoolAttendanceCodes", fields: [organizationId], references: [id], onDelete: Cascade)

  code        String               @unique
  classId     String
  date        DateTime
  termId      String
  createdById String
  windowMins  Int                  @default(5)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  usages      AttendanceCodeUsage[]

  @@index([code])
  @@index([classId, date])
}

model AttendanceCodeUsage {
  id        String         @id @default(uuid())
  codeId    String
  studentDataId String
  usedAt    DateTime       @default(now())
  code      AttendanceCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([codeId, studentDataId])
}

model FeeType {
  id             String           @id @default(uuid())
  organizationId String
