model ServiceSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation("OrgServiceSettings", fields: [organizationId], references: [id], onDelete: Cascade)

  appointmentsEnabled Boolean @default(true)
  jobsEnabled         Boolean @default(false)
  quotesEnabled       Boolean @default(false)
  onlineBookingEnabled Boolean @default(false)

  currencySymbol  String   @default("$")
  taxRate         Float    @default(0) // Percentage
  bookingBufferMinutes Int @default(15)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
}

model ServiceCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?

  items          ServiceCatalogItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model ServiceCatalogItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceCatalogItems", fields: [organizationId], references: [id], onDelete: Cascade)
  
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name           String
  description    String?
  price          Float
  durationMinutes Int
  isActive       Boolean      @default(true)
  imageAssetId   String?

  addons         ServiceAddon[]
  appointments   ServiceAppointment[]
  jobs           ServiceJob[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}

model ServiceAddon {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceAddons", fields: [organizationId], references: [id], onDelete: Cascade)
  
  serviceId      String?
  service        ServiceCatalogItem? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name           String
  price          Float
  durationMinutes Int @default(0)

  appointmentAddons ServiceAppointmentAddon[]
  jobAddons         ServiceJobAddon[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
}



model ServiceAppointment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgServiceAppointments", fields: [organizationId], references: [id], onDelete: Cascade)

  customerDataId     String
  customer       CustomerData  @relation(fields: [customerDataId], references: [id], onDelete: Cascade)

  serviceId      String
  service        ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  membershipId        String?
  staff          Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  startTime      DateTime
  endTime        DateTime
  status         String       @default("PENDING") // PENDING, CONFIRMED, CHECKED_IN, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  
  price          Float
  deposit        Float        @default(0)
  notes          String?

  jobId          String?      @unique
  job            ServiceJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  addons         ServiceAppointmentAddon[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
