  comboId        String
  combo          MenuItemCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  menuItemId     String?
  menuItem       MenuItem?     @relation("ComboItems", fields: [menuItemId], references: [id])
  name           String
  quantity       Int          @default(1)
