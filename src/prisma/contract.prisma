enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

model RestaurantOrder {
  id             String       @id @default(uuid())
  totalAmount    Float
  status         OrderStatus  @default(PENDING)
  type           OrderType    @default(DINE_IN)
  tableNumber    String?      // If DINE_IN (legacy free-text; prefer tableId)
  
  // RestaurantOS: POS / KDS / call-out
  orderNumber    Int?         // sequential, called out at the counter
  tableId        String?
  table          RestaurantTable? @relation("TableOrders", fields: [tableId], references: [id])
  paymentMethod  String?      // WALLET | CASH | POS
  paidAt         DateTime?
  servedByMembershipId String?
  
  organizationId String
  customerDataId     String?      // The user who placed the order
  
  organization   Organization @relation("RestaurantOrders", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantOrders", fields: [locationId], references: [id])
  customer       CustomerData?        @relation("CustomerRestaurantOrders", fields: [customerDataId], references: [id])
  
  items          OrderItem[]
  
  payment        Payment?
  delivery       DeliveryJob?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model OrderItem {
  id             String          @id @default(uuid())
  quantity       Int             @default(1)
  unitPrice      Float
  notes          String?         // Special instructions
  
  orderId        String
  menuItemId     String
  
  order          RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// RESTAURANTOS (Restaurants, Eateries & Fast Food)
// ----------------------------------------------------------------------------
// One OS, three operating styles configured via RestaurantSettings.serviceStyle:
//   FULL_SERVICE (restaurants — tables, reservations, courses)
//   COUNTER      (fast food — POS-first, order numbers, combos)
//   HYBRID       (eateries — walk-in heavy, optional tables)
// Every style gets POS, Inventory and the Financial Manager.

model RestaurantSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation("OrgRestaurantSettings", fields: [organizationId], references: [id], onDelete: Cascade)

  serviceStyle   String  @default("HYBRID") // FULL_SERVICE | COUNTER | HYBRID
  taxRate        Float   @default(0)
  serviceCharge  Float   @default(0) // full-service service charge (%)
  openingHours   String? // e.g. "8:00 AM - 10:00 PM" or JSON
  acceptsWalkIns Boolean @default(true)
  nextOrderNumber Int    @default(1) // sequential call-out number (fast food)

  // Payment configuration
  paymentGateway String?
  bankDetails    String?      // JSON: { bankName, accountNumber, accountName }
  walletSettlementEnabled Boolean @default(false)

  // Onboarding progress flags
  hasSetPayment  Boolean @default(false)
  hasMenu        Boolean @default(false)
  hasTables      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RestaurantTable {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("RestaurantTables", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantTables", fields: [locationId], references: [id])

  name           String       // "T1", "Window 2", "Booth 3"
  seats          Int          @default(4)
  status         String       @default("available") // available | occupied | reserved

  orders         RestaurantOrder[] @relation("TableOrders")
  reservations   RestaurantReservation[] @relation("TableReservations")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RestaurantReservation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRestaurantReservations", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantReservations", fields: [locationId], references: [id])

  tableId        String?
  table          RestaurantTable? @relation("TableReservations", fields: [tableId], references: [id])
  customerDataId String?
  customer       CustomerData?    @relation("RestaurantReservationCustomer", fields: [customerDataId], references: [id])
  customerName   String?      // walk-in bookings without a customer record
  customerPhone  String?
  partySize      Int          @default(2)
  scheduledAt    DateTime
  status         String       @default("pending") // pending | confirmed | seated | completed | cancelled
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}



enum InventoryItemType {
  RAW_MATERIAL      // Flour, Salt, Raw Beef
  SUB_ASSEMBLY      // Pizza Dough, Stew Base (Produced in-house, used in recipes)
  FINISHED_GOOD     // A ready-to-sell item (e.g. Bottled Water, or 1 Plate of Jollof prepped in bulk)
}

model RestaurantInventoryItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("RestaurantInventory", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantInventory", fields: [locationId], references: [id])

  name           String
  type           InventoryItemType @default(RAW_MATERIAL)
  unit           String       @default("unit") // The base unit: grams, ml, pcs
  
  quantity       Float        @default(0) // Current stock level
  lowStockLevel  Float        @default(5)
  cost           Float        @default(0) // Moving Average Cost (MAC) per unit

  // If this item is a SUB_ASSEMBLY or FINISHED_GOOD, it can have a Recipe to produce it
  recipeId       String?      @unique
  recipe         RestaurantRecipe? @relation("ItemRecipe", fields: [recipeId], references: [id])

  movements      RestaurantStockMovement[]
  recipeIngredients RestaurantRecipeIngredient[] @relation("IngredientItem")
  menuItems      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RestaurantRecipe {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("RestaurantRecipes", fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       // e.g., "1 Cooler of Jollof Rice"
  yieldQuantity  Float        // e.g., 50 (portions)
  instructions   String?
  
  ingredients    RestaurantRecipeIngredient[]
  
  // The inventory item this recipe produces (e.g., 50 Portions of Jollof Rice)
  producedItem   RestaurantInventoryItem? @relation("ItemRecipe")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model RestaurantRecipeIngredient {
  id             String       @id @default(uuid())
  recipeId       String
  recipe         RestaurantRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  itemId         String
  item           RestaurantInventoryItem @relation("IngredientItem", fields: [itemId], references: [id], onDelete: Restrict)
  
  quantity       Float        // Amount of this item required for the recipe yield
  
  createdAt DateTime @default(now())
}

enum StockMovementType {
  MANUAL_ADJUSTMENT
  PURCHASE_RECEIPT    // GRN
  PRODUCTION_YIELD    // Added to stock via production run
  PRODUCTION_USAGE    // Deducted from stock to produce a batch
  POS_SALE            // Deducted because a waiter sold it
  WASTE               // Dropped, burnt, expired
}

model RestaurantStockMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("RestaurantStockMovements", fields: [organizationId], references: [id], onDelete: Cascade)
  
  itemId         String
  item           RestaurantInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  type           StockMovementType @default(MANUAL_ADJUSTMENT)
  delta          Float        // positive = restock, negative = usage
  unitCost       Float        @default(0) // The cost of the item at the time of movement
  note           String?
  
  recordedById   String?      // Membership id

  createdAt DateTime @default(now())
}

model RestaurantProductionRun {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRestaurantProductionRuns", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantProductionRuns", fields: [locationId], references: [id])
  
  recipeId       String
  recipe         RestaurantRecipe @relation(fields: [recipeId], references: [id])
  
  batchMultiplier Float       // e.g., 2 = double the recipe
  expectedYield   Float
  actualYield     Float       // Chef enters what they actually got (handles shrinkage)
  
  totalCost       Float       @default(0) // The calculated cost of all raw materials used
  
  status         String       @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  
  recordedById   String?

  createdAt DateTime @default(now())
}


model RestaurantExpense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("OrgRestaurantExpenses", fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation("LocationRestaurantExpenses", fields: [locationId], references: [id])

  category       String       @default("ingredients") // ingredients | gas | staff | rent | utilities | other
  amount         Float
  note           String?
  spentAt        DateTime     @default(now())

  createdAt DateTime @default(now())
}

