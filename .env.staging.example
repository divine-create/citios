# ==============================================================================
# CityOS Staging Environment Template (.env.staging.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.staging` for local staging simulation or copy values
#    to your staging hosting provider's environment variable secrets manager.
# 2. Never commit `.env.staging` with real credentials to source control.
# ==============================================================================

# Environment Identifier
APP_ENV="staging"
CITYOS_ENV="staging"
NODE_ENV="production"

# Database Configuration (PostgreSQL 16 Isolated Staging Instance)
# MUST NOT point to the shared production database (aws-1-eu-west-1.pooler.supabase.com)
DATABASE_URL="postgresql://cityos_staging_user:STAGING_STRONG_PASSWORD@staging-db.example.com:5432/cityos_staging"
DIRECT_URL="postgresql://cityos_staging_user:STAGING_STRONG_PASSWORD@staging-db.example.com:5432/cityos_staging"

# NextAuth Staging Configuration
NEXTAUTH_URL="https://staging.cityos.ng"
NEXTAUTH_SECRET="GENERATE_64_CHAR_STAGING_NEXTAUTH_SECRET"

# CityDrive Network Policy & Fleet Configuration
# In CITYOS_ONLY mode, only riders belonging to organizations listed in CITYOS_FLEET_ORG_IDS can be dispatched.
# CITYOS_FLEET_ORG_IDS must be explicitly authorized by Platform Operations Leadership.
CITYDRIVE_NETWORK_POLICY="CITYOS_ONLY"
CITYOS_FLEET_ORG_IDS="AUTHORIZED_STAGING_FLEET_UUID_HERE"

# Real-Time Mobile Push Configuration (Pusher Channels - Staging App)
PUSHER_APP_ID="STAGING_PUSHER_APP_ID"
PUSHER_KEY="STAGING_PUSHER_KEY"
PUSHER_SECRET="STAGING_PUSHER_SECRET"
NEXT_PUBLIC_PUSHER_KEY="STAGING_PUSHER_KEY"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Live SMS / OTP Verification (Termii Gateway)
TERMII_API_KEY="STAGING_OR_LIVE_TERMII_API_KEY"
TERMII_SENDER_ID="CityDrive"
TERMII_URL="https://api.ng.termii.com/api/sms/send"

# Payment Gateway (Paystack Test Mode)
# Optional for internal zero-value or COD test parcels; required for card checkout testing.
PAYSTACK_SECRET_KEY="sk_test_STAGING_PAYSTACK_KEY"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_STAGING_PAYSTACK_KEY"
