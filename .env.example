# Connection string for PostgreSQL (Requires PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret"

# OAuth Providers (Optional for local development if demo login is used)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# WhatsApp Cloud API (optional; order notifications are skipped when unset)
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_API_VERSION="v20.0"

# AssemblyAI Configuration
ASSEMBLYAI_API_KEY=

# Resend Email Configuration (Password Recovery & Notifications)
# For testing: use "onboarding@resend.dev"
# For production: verify your domain on resend.com and use "9jaLive <auth@yourdomain.ng>"
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="9jaLive <onboarding@resend.dev>"
